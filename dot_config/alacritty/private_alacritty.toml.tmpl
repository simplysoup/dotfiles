env = { TERM = "xterm-256color" }

[window]
decorations = "full"  # "none" for borderless
opacity = 0.90
dynamic_title = true
startup_mode = "Maximized"  # Alternatives: "Windowed", "Fullscreen"

[window.padding]
x = 5
y = 5

[scrolling]
history = 10000
multiplier = 3

[font]
size = 12.0

[font.normal]
family = "Fira Code"
style = "Regular"

[font.bold]
family = "Fira Code"
style = "Bold"

[font.italic]
family = "Fira Code"
style = "Italic"

[cursor]
style = { shape = "Block", blinking = "On" }  # Correct modern syntax

[selection]
save_to_clipboard = true

[general]
# ~/.config/alacritty/alacritty.toml
import = ["{{ .chezmoi.homeDir }}/.config/alacritty/worldwall-theme.toml"]
